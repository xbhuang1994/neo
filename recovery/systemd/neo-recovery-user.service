# Independent Neo Recovery Daemon as a systemd user service.
# Replaces direct execution of neo-agent.service so that this independent daemon
# launches Neo, sniffs /api/health, automatically invokes Neo's configured backend
# worker on prolonged unavailability, and exposes live repair progress at Neo's
# entry point (:3082).
#
# Environment (NEO_TOKEN, PATH) lives in ~/.config/neo-agent/neo-agent.env.
[Unit]
Description=Neo Independent Recovery Daemon (supervising Neo Agent)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/nvme/workspace/neo
EnvironmentFile=%h/.config/neo-agent/neo-agent.env
ExecStart=%h/.local/bin/neo-recovery start --mode proxy --host 0.0.0.0 --port 3082 --internal-port 13082 --target-bin /nvme/workspace/neo/backend/dist/neo-agent --web-dir /nvme/workspace/neo/app/build/web --repo-dir /nvme/workspace/neo --data-dir %h/.local/state/neo-agent --state-dir %h/.local/state/neo-recovery --unhealthy-after 60
Restart=always
RestartSec=3
KillMode=control-group
TimeoutStopSec=35
StandardOutput=append:%h/.local/state/neo-recovery.log
StandardError=append:%h/.local/state/neo-recovery.log

[Install]
WantedBy=default.target
