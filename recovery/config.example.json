{
  "mode": "proxy",
  "host": "0.0.0.0",
  "port": 3082,
  "internalPort": 13082,
  "targetBin": "/nvme/workspace/neo/backend/dist/neo-agent",
  "targetArgs": ["serve"],
  "targetCwd": "/nvme/workspace/neo",
  "webDir": "/nvme/workspace/neo/app/build/web",
  "dataDir": "/home/henry/.local/state/neo-agent",
  "repoDir": "/nvme/workspace/neo",
  "stateDir": "/home/henry/.local/state/neo-recovery",
  "logFile": "/home/henry/.local/state/neo-agent-serve.log",
  "probeIntervalSec": 5,
  "probeTimeoutSec": 5,
  "unhealthyAfterSec": 60,
  "minFailedProbes": 3,
  "fastRestartDelaySec": 3,
  "startupTimeoutSec": 30,
  "stableProbes": 2,
  "workerTimeoutSec": 600,
  "maxAttempts": 3,
  "cooldownSec": 30,
  "exhaustedRetrySec": 900
}
