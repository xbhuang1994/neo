{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowClusterArtifactBucketList",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::neo-artifacts",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "${CLUSTER_ID}",
            "${CLUSTER_ID}/*"
          ]
        }
      }
    },
    {
      "Sid": "AllowClusterArtifactPrefixReadWrite",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": "arn:aws:s3:::neo-artifacts/${CLUSTER_ID}/*"
    },
    {
      "Sid": "DenyOtherBucketsAndPrefixes",
      "Effect": "Deny",
      "Action": "s3:*",
      "NotResource": [
        "arn:aws:s3:::neo-artifacts",
        "arn:aws:s3:::neo-artifacts/${CLUSTER_ID}/*"
      ]
    },
    {
      "Sid": "DenyCrossClusterBucketListing",
      "Effect": "Deny",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::neo-artifacts",
      "Condition": {
        "StringNotLike": {
          "s3:prefix": [
            "${CLUSTER_ID}",
            "${CLUSTER_ID}/*"
          ]
        }
      }
    }
  ]
}
