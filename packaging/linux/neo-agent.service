# A systemd unit for Neo as a server. Copy it to /etc/systemd/system/neo-agent.service, set the paths, the
# user and the token, then: systemctl daemon-reload && systemctl enable --now neo-agent
[Unit]
Description=Neo
After=network-online.target
Wants=network-online.target

[Service]
User=neo
# The token every client must present; at least 16 characters. Keep this file readable by root only.
Environment=NEO_TOKEN=change-me-to-a-long-random-string
ExecStart=/opt/neo-agent/neo-agent serve --host 0.0.0.0 --port 3082 --data-dir /var/lib/neo-agent
Restart=on-failure
RestartSec=5
# Workers and their background jobs end with the service.
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
